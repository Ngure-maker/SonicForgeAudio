# SKU generation
SKU_FORMAT={category}-{product}-{variant}-{random}
SKU_MAX_RETRIES=5
SKU_RANDOM_DIGITS=4
SKU_INCLUDE_CATEGORY_SEQUENCE=False
SKU_INCLUDE_TIMESTAMP_SUFFIX=False
SKU_TIMESTAMP_FORMAT=%y%m%d
